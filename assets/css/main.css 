/* Reset and base styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
  color: #333;
  background: #fff;
}

/* Layout */
.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

/* Navigation */
nav {
  margin-bottom: 2rem;
}

nav a {
  margin-right: 1rem;
  text-decoration: none;
  color: #0066cc;
}

nav a:hover {
  text-decoration: underline;
}

/* Typography */
h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

h2 {
  font-size: 1.25rem;
  font-weight: 400;
  color: #555;
  margin-bottom: 1.5rem;
}

p {
  margin-bottom: 1rem;
  max-width: 700px;
}

ul {
  margin: 1rem 0 1.5rem 1.5rem;
}

li {
  margin-bottom: 0.25rem;
}

/* Button */
.button {
  display: inline-block;
  padding: 0.75rem 1.25rem;
  background: #0066cc;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  margin-top: 0.5rem;
}

.button:hover {
  background: #0052a3;
  text-decoration: none;
}

/* Footer */
footer {
  margin-top: 3rem;
  padding-top: 1rem;
  border-top: 1px solid #eee;
  font-size: 0.875rem;
  color: #777;
}
